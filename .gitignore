# Runtime state and secrets: generated bearer tokens, controller state,
# cycle prompts and worktrees. Never committed.
audit-loop/state/
audit-loop/.venv/
science-audit-controller/data/

# Machine-specific files generated by install.sh from the *.template /
# *.example.yaml files that ARE committed.
audit-loop/orchestrator/config.yaml
audit-loop/orchestrator/projects.yaml
audit-loop/hooks/post-commit
audit-loop/launchd/*.plist

__pycache__/
*.pyc
.pytest_cache/
.DS_Store
