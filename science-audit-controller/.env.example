# Required for GitHub webhook authentication.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Required service tokens. Use distinct random values.
ACTION_API_TOKEN=replace-with-an-action-caller-token
CLAUDE_API_TOKEN=replace-with-a-claude-submission-token
PI_APPROVAL_TOKEN=replace-with-a-pi-approval-token
CONTROLLER_READ_TOKEN=replace-with-a-read-only-token

# GitHub REST API mode. GITHUB_TOKEN needs read access to both repositories.
GITHUB_TOKEN=replace-with-a-github-app-installation-token
SCIENCE_REPO_FULL_NAME=dongzhaohe321418-lab/perovskite-screening
AUDIT_REPO_FULL_NAME=dongzhaohe321418-lab/perovskite-screening-audit
GITHUB_API_URL=https://api.github.com

CONTROLLER_STATE_PATH=./data/state.json
PROJECT_CONFIG_PATH=./config/projects.example.yaml
DELIVERY_LEASE_SECONDS=300

# Alternative local-clone mode. If set, these take precedence over GitHub REST reads.
# SCIENCE_REPO_PATH=/path/to/perovskite-screening
# AUDIT_REPO_PATH=/path/to/perovskite-screening-audit
